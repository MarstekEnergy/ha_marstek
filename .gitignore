# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Virtual environments
.venv/
.venv-ha/
venv/
env/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Test, lint and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Dev-only lock file (not needed for HACS distribution)
uv.lock

# Logs
*.log
home-assistant_*.log

# Reference documents (not needed in the repo)
*.pdf
# ...except the official Open API document shipped in docs/
!docs/*.pdf

# OS
.DS_Store
Thumbs.db

# Local agent / tooling data
.codebuddy/
.agents/
.aws/
.codex/

# Local scratch workspace: API doc drafts, review notes, ad-hoc experiments.
# Everything in here is deliberately untracked — never referenced by the
# integration at runtime, so it must not reach HACS.
ignore/
